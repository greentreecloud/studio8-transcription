# config.yaml
# Central configuration for Studio8 transcription.

version: "1.0.0"

runtime:
  output_dir: "/opt/transcription/output"
  settle_time: 5
  batch_poll_interval: 10
  worker_poll: 3
  update_branch: "main"
  staging_copy_max_gb: 5.0

branding:
  organization: "Your Organization"
  app_name: "Transcription"
  footer: "WhisperX · pyannote · Your Organization"
  system_subtitle: "System Status"
  queue_subtitle: "Queue"

colors:
  bg: "#080808"
  surface: "#111111"
  surface2: "#1a1a1a"
  border: "#333333"
  border2: "#484848"
  text: "#f0f0f0"
  muted: "#888888"
  green: "#39d98a"
  amber: "#ffcc00"
  red: "#ff5555"
  blue: "#58a6ff"

model:
  whisper_model: "large-v3"
  device: "cuda"
  compute_type: "float16"

  # null = automatic language detection. When multilingual.enabled is true,
  # automatic detection runs per VAD/time window instead of once per file.
  default_language: null

  upload_languages:
    - ["en", "English"]
    - ["de", "Deutsch"]
    - ["es", "Español"]
    - ["fr", "Français"]

  batch_size: 2
  tc_interval: 60

# Automatic multilingual mode is only used when no language is forced.
multilingual:
  enabled: true

  # Long VAD speech turns are split into overlapping LID windows.
  lid_window_seconds: 8.0
  lid_overlap_seconds: 2.0

  # Number of LID windows encoded together.
  # Reduce if GPU memory becomes tight.
  lid_batch_size: 8

  # A differing window below this confidence does not trigger a switch.
  lid_min_confidence: 0.70

  # Number of consecutive confident windows needed to confirm a switch.
  switch_confirm_windows: 2

  # Blocks shorter than this are merged into a neighbour.
  min_block_seconds: 3.0

output:
  # Global default for jobs that do not specify a per-workflow override.
  # Per watchfolder use `speakers_json: true|false`.
  speakers_json_default: false

watchdog:
  poll_interval: 30
  stuck_job_timeout: 3600
  staging_max_age_hours: 24

priority:
  manual_upload: 10
  watchfolder_default: 5
  max_retries: 3

transcript:
  date_label: "Date"
  file_label: "File"
  duration_label: "Duration"
  language_label: "Language"
  timecode_label: "Timecode start"
  separator_char: "─"
  separator_length: 44
  fallback_speaker: "SPEAKER_A"
