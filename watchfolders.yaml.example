# watchfolders.yaml
#
# `speakers_json` controls the JSON output PER WORKFLOW.
# Default: false (also inherited from config.yaml -> output.speakers_json_default).

watchfolders:

  # ── Single mode ────────────────────────────────────────────────────────────
  - name: "General Intake"
    mode: single
    path: "/opt/transcription/watchfolder"
    output: "/opt/transcription/output"
    priority: 5
    enabled: true

    # false = TXT only
    # true  = TXT + <name>_speakers.json
    speakers_json: false

    # Optional: force one language and skip multilingual LID.
    # language: "en"

    # Optional for CIFS/NFS:
    # poll: true
    # poll_interval: 10

  # ── Batch mode ─────────────────────────────────────────────────────────────
  - name: "NAS Archive — Current"
    mode: batch
    path: "/mnt/Archive/Ingest/Current"

    outputs:
      - "same_as_source"
      # - "/mnt/Archive/Transcripts"
      # - "/opt/transcription/output"

    priority: 7
    enabled: true
    done_extension: ".done"
    delete_done_file: true

    # JSON output is controlled independently for this workflow.
    speakers_json: false

    # Optional: force one language and skip multilingual LID.
    # language: "de"
